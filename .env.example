# Copy this file to .env.local and fill in the value.
# Neon: Project dashboard -> Connect -> "Pooled connection" string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional; the button is hidden while these are empty).
# Redirect URI to register: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
